#!/usr/bin/env zsh
set -euo pipefail

PROJECT_DIR="/Users/antoniojparedes/Dev/Python/youtube-downloader"
VENV_DIR="$PROJECT_DIR/venv"
PYTHON_BIN="${PYTHON_BIN:-python3}"

if [[ ! -d "$PROJECT_DIR" ]]; then
  print -u2 "No se encuentra el proyecto en: $PROJECT_DIR"
  exit 1
fi

if [[ ! -x "$VENV_DIR/bin/python" ]]; then
  print "Creando entorno virtual en $VENV_DIR..."
  "$PYTHON_BIN" -m venv "$VENV_DIR"
fi

if ! "$VENV_DIR/bin/python" -c 'import certifi, curl_cffi, pytubefix, yt_dlp, yt_dlp_ejs' 2>/dev/null; then
  print "Instalando dependencias del proyecto..."
  "$VENV_DIR/bin/python" -m pip install -q -r "$PROJECT_DIR/requirements.txt"
fi

exec "$VENV_DIR/bin/python" "$PROJECT_DIR/youtube_downloader.py" "$@"
